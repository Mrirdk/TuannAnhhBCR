<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/robotRootContainer"
    android:layout_width="276dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_v9_overlay_shell"
    android:orientation="vertical"
    android:padding="9dp">

    <!-- Draggable Top Bar: TuannAnhh BCR V9 + Coins + Minimize/Close -->
    <LinearLayout
        android:id="@+id/robotHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvOverlayTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ TUANNANHH BCR V9"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOverlayCoinBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="999 Xu"
            android:textColor="@color/accent_gold"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggleMinimize"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:text="—"
            android:textColor="#00F5D4"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseOverlay"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:text="✕"
            android:textColor="#FF2A55"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ALWAYS VISIBLE HERO ROW: Animated Robot + Compact Square Prediction Tile (CÁI / CON + %) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Animated Robot Avatar -->
        <FrameLayout
            android:id="@+id/flOverlayRobotBox"
            android:layout_width="68dp"
            android:layout_height="96dp">

            <View
                android:id="@+id/viewOverlayRobotAura"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_v9_robot_aura_rgb" />

            <ImageView
                android:id="@+id/ivOverlayRobot"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:contentDescription="Robot TuannAnhh"
                android:src="@drawable/ic_robot_cutout" />
        </FrameLayout>

        <!-- Compact Square Box showing CÁI / CON / CHỜ + Calibrated Probability % -->
        <LinearLayout
            android:id="@+id/boxSquarePrediction"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_v9_square_wait"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/tvSquareTopTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TUANNANHH"
                android:textColor="#FEE440"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSquareSideLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="CHỜ"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSquareProbValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="50.7%"
                android:textColor="#00F5D4"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right-side compact telemetry readout -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTimingBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHỜ KHÓA KHUNG"
                android:textColor="@color/accent_emerald"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMarkovProb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="CÁI: 50.7%\nCON: 49.3%"
                android:textColor="@color/text_primary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHitMissStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Chuẩn: 0 | Gãy: 0"
                android:textColor="@color/accent_gold"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Collapsible Details & Action Controls (Hide with '—' to keep ONLY Robot + Square Box) -->
    <LinearLayout
        android:id="@+id/layoutExpandableBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvResultAnnouncement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_result_banner"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:text="ĐỒNG BỘ BẢNG CẦU TUANNANHH V9..."
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutRobotBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_robot_bubble"
            android:orientation="vertical"
            android:padding="7dp">

            <TextView
                android:id="@+id/tvRobotStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Căn khung vàng khớp bảng cầu rồi bấm BẮT ĐẦU!"
                android:textColor="@color/accent_gold"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMainRoadStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Nhịp cột: Đang chờ dữ liệu..."
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvRecentBeads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chuỗi bắt được: --"
                android:textColor="@color/text_secondary"
                android:textSize="9.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnToggleScan"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_v9_btn_rainbow"
                android:text="BẮT ĐẦU"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="5dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnToggleTarget"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_weight="1.05"
                android:background="@drawable/bg_btn_outline_cyan"
                android:text="KHÓA KHUNG"
                android:textColor="@color/accent_cyan"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="5dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnResetRoad"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_weight="0.8"
                android:background="@drawable/bg_v9_btn_neon_gold"
                android:text="LÀM MỚI"
                android:textColor="#090D16"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
