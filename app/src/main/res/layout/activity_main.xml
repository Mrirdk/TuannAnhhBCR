<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_v9_cyber_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Live Neon RGB Status Pill -->
        <TextView
            android:id="@+id/tvTopLivePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_v9_status_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="⚡ HỆ THỐNG AI V9 • XÁC SUẤT CHUẨN ⚡"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Multi-Ring Animated Robot Hero Stage -->
        <FrameLayout
            android:id="@+id/heroRobotContainer"
            android:layout_width="162dp"
            android:layout_height="162dp"
            android:layout_marginTop="10dp">

            <View
                android:id="@+id/viewRobotOuterRing"
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_v9_robot_ring_outer" />

            <View
                android:id="@+id/viewLoginRobotAura"
                android:layout_width="138dp"
                android:layout_height="138dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_v9_robot_aura_rgb" />

            <ImageView
                android:id="@+id/ivLoginRobot"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:contentDescription="TuannAnhh BCR Robot"
                android:src="@drawable/ic_robot_cutout" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.08"
            android:text="TUANNANHH BCR"
            android:textColor="@color/accent_gold"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVersionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_v9_btn_rainbow"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:text="PHIÊN BẢN V9 • BẢNG VUÔNG &amp; XÁC SUẤT THỰC"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Soi Thế Cầu 1-2 • 1-3 • 1-4 • Bậc Thang • Cầu Gương"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Neon Login Card -->
        <LinearLayout
            android:id="@+id/cardLoginSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_v9_neon_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ ĐĂNG NHẬP TUANNANHH BCR V9"
                android:textColor="@color/accent_cyan"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Bấm Dùng Thử Nhanh (vip01 / 123456) để mở Robot ngay"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etLoginUser"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_field"
                android:hint="Tên đăng nhập (VD: vip01)"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#7B84B2"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etLoginPass"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field"
                android:hint="Mật khẩu"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#7B84B2"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLoginSubmit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_v9_btn_neon_gold"
                    android:text="ĐĂNG NHẬP"
                    android:textColor="#090D16"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnQuickDemo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_outline_cyan"
                    android:text="DÙNG THỬ"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLoginFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Trạng thái: Chưa đăng nhập"
                android:textColor="@color/accent_gold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Rainbow VIP Dashboard Card -->
        <LinearLayout
            android:id="@+id/cardDashboardSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_v9_rainbow_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWelcomeUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xin chào, VIP01"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCoinBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_v9_status_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="999 Xu"
                    android:textColor="@color/accent_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etRedeemKey"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="Mã Key (VIP10 / PRO30 / TUANNANHH9)"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#7B84B2"
                    android:textSize="12.5sp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnRedeemKey"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_btn_outline_cyan"
                    android:paddingHorizontal="14dp"
                    android:text="NẠP KEY"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLaunchRobot"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_v9_btn_rainbow"
                android:text="🚀 BẬT ROBOT TUANNANHH BCR V9"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:text="Đăng xuất tài khoản"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Admin Panel -->
        <LinearLayout
            android:id="@+id/cardAdminSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_v9_neon_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑 ADMIN CẤP TÀI KHOẢN &amp; XU"
                android:textColor="@color/accent_gold"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAdminTargetUser"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="Username cần tạo / cộng xu"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#7B84B2"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etAdminTargetPass"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="Mật khẩu (mặc định 123456)"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#7B84B2"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etAdminTargetCoins"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="Số xu cộng thêm (VD: 50)"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#7B84B2"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAdminGrant"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_v9_btn_neon_gold"
                android:text="CẤP TÀI KHOẢN / CỘNG XU"
                android:textColor="#090D16"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
